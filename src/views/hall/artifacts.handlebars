<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: 'Montserrat', sans-serif;
      min-height: 100vh;
      position: relative;
    }
    .artifacts-background {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: url('/images/literary-hall/artifacts-background.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      z-index: 0;
    }
    .top-left-image {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 2;
        width: 78%;
        max-width: 1400px;
        min-width: 250px;
        height: auto;
    }
    
    .title-image-wrapper {
        position: relative;
        width: 100%;
        height: auto;
        overflow: visible;
        border-radius: 0;
    }
    
    .title-image-bg {
        position: relative;
        width: 100%;
        height: auto;
        aspect-ratio: auto;
        background-size: 100% 100%;
        background-position: center;
        background-repeat: no-repeat;
        border-radius: 0;
        padding-bottom: 10%;
        transition: transform 0.3s ease;
    }
    
    .person-name-overlay {
        position: absolute;
        top: 50%;
        right: 4%;
        transform: translateY(-50%);
        color: black;
        white-space: nowrap;
        font-family: 'Comic Sans MS', 'Comic Sans', cursive;
        pointer-events: none;
        text-align: right;
        display: flex;
        gap: 17px;
        align-items: baseline;
        justify-content: flex-end;
        z-index: 2;
        max-width: 85%;
    }
    
    .person-surname {
        font-weight: 800;
        font-size: clamp(14px, 4vw, 50px);
        text-transform: uppercase;
        letter-spacing: 2px;
        display: inline-block;
        font-family: 'Comic Sans MS', 'Comic Sans', cursive;
    }
    
    .person-firstname {
        font-weight: 400;
        font-size: clamp(10px, 3vw, 50px);
        display: inline-block;
        white-space: nowrap;
        font-family: 'Comic Sans MS', 'Comic Sans', cursive;
    }
    .artifacts-content {
      position: relative;
      z-index: 1;
      height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding: 120px 60px 100px 60px;
    }
    .artifacts-header {
      text-align: center;
      margin-bottom: 30px;
    }
    .artifacts-header h1 {
      font-size: 28px;
      color: #333;
      margin-bottom: 5px;
      text-shadow: 2px 2px 4px rgba(255,255,255,0.5);
    }
    .artifacts-header .person-name {
      font-size: 16px;
      color: #667eea;
      font-weight: 600;
    }
    .artifacts-grid-container {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      flex: 1;
    }
    .artifacts-grid {
      display: grid;
      gap: 20px 25px;
      width: 100%;
      max-width: 2000px;
      margin: 0 auto;
      justify-items: center;
      align-items: center;
    }
    /* Карточка артефакта */
    .artifact-card {
      position: relative;
      width: 100%;
      max-width: 800px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      border: none;
      cursor: pointer;
      background: transparent;
      transition: transform 0.3s ease;
      border-radius: 0;
      overflow: visible;
      box-shadow: none;
      outline: none;
    }
    .artifact-card:focus { outline: none; }
    .artifact-card::-moz-focus-inner { border: 0; }
    .artifact-image {
      width: 100%;
      height: auto;
      background-size: contain;
      background-position: center;
      background-repeat: no-repeat;
      border-radius: 0;
      box-shadow: none;
      border: none;
      aspect-ratio: 1 / 1;
      transition: transform 0.3s ease;
    }
    .artifact-name-overlay {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
      color: white;
      font-size: 50px;
      font-weight: 600;
      font-family: 'Comic Sans MS', 'Comic Sans', cursive;
      text-shadow: none;
      background: transparent;
      padding: 0;
      width: 75%;
      word-wrap: break-word;
      white-space: normal;
      line-height: 1.3;
      pointer-events: none;
    }
    .artifact-card:hover { transform: scale(1.05); }
    .artifact-card:active { transform: scale(0.98); }

    /* Навигационные кнопки */
    .nav-button {
      position: fixed;
      bottom: 30px;
      z-index: 10;
      width: 180px;
      height: auto;
      cursor: pointer;
      transition: opacity 0.3s ease, transform 0.3s ease;
      border: none;
      background: transparent;
      padding: 0;
      border-radius: 0;
      outline: none;
      opacity: 1;
    }
    .nav-button.disabled {
      opacity: 0.4;
      pointer-events: none;
      cursor: default;
    }
    .nav-button:hover:not(.disabled) { transform: scale(1.05); }
    .nav-button:active:not(.disabled) { transform: scale(0.98); }
    .nav-button-img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }
    .back-button { left: 100px; }
    .next-button { right: 100px; }

    /* Номер страницы — скрыт */
    .page-info {
      display: none;
    }

    .no-artifacts {
      text-align: center;
      padding: 60px;
      background: rgba(255,255,255,0.9);
      border-radius: 20px;
      max-width: 500px;
      margin: 0 auto;
    }
    .no-artifacts p {
      font-size: 18px;
      color: #666;
      margin-bottom: 20px;
    }

    /* ===== СПЕЦИАЛЬНО ДЛЯ 2 АРТЕФАКТОВ ===== */
    .artifacts-grid.grid-2 {
      grid-template-columns: repeat(2, 1fr); /* 2 колонки */
      gap: 20px 300px;  /* горизонтальное расстояние увеличено */
    }

    @media (max-width: 1024px) {
      .artifacts-content { padding: 100px 40px 80px 40px; }
      .artifacts-grid { gap: 15px 20px; }
      .artifact-name-overlay { font-size: 14px; }
      .artifact-image { width: 90%; }
      .nav-button { width: 60px; height: 60px; }
      .artifacts-grid.grid-2 { gap: 20px 80px; }
      .artifact-card { max-width: 500px; }
    }
    @media (max-width: 768px) {
      .artifacts-content { padding: 80px 20px 80px 20px; }
      .artifacts-grid { gap: 15px 15px; }
      .artifacts-header h1 { font-size: 28px; }
      .artifact-name-overlay { font-size: 12px; }
      .artifact-image { width: 90%; }
      .nav-button { width: 50px; height: 50px; bottom: 20px; }
      .artifacts-grid.grid-2 { gap: 15px 40px; }
      .artifact-card { max-width: 350px; }
    }
    @media (max-width: 480px) {
      .artifacts-content { padding: 70px 15px 70px 15px; }
      .artifacts-grid { gap: 15px; }
      .artifact-name-overlay { font-size: 14px; }
      .artifact-image { width: 80%; }
      .nav-button { width: 40px; height: 40px; }
      .artifacts-grid.grid-2 { gap: 15px 20px; }
      .artifact-card { max-width: 200px; }
    }
  </style>
</head>
<body>
  <div class="artifacts-background"></div>

  <!-- Левое верхнее изображение с ФИО поверх -->
    <div class="top-left-image">
        <div class="title-image-wrapper">
            <div class="title-image-bg" style="background-image: url('{{person.titleImagePath}}');"></div>
        </div>
    </div>

  <div class="artifacts-content">
    {{#if artifacts.length}}
    <div class="artifacts-grid-container">
      <div class="artifacts-grid grid-2" id="artifactsGrid">
        {{#each artifacts}}
        <button class="artifact-card" data-artifact-index="{{@index}}" data-artifact-name="{{name}}" style="display: none;">
          <div class="artifact-image" style="background-image: url('{{imagePath}}');"></div>
        </button>
        {{/each}}
      </div>
    </div>
    {{else}}
    <div class="no-artifacts">
      <p>📦 В данный момент артефакты отсутствуют</p>
    </div>
    {{/if}}
  </div>

  <!-- Кнопки пагинации -->
  <button class="nav-button back-button" id="prevPageBtn">
    <img src="/images/back-button.png" alt="Назад" class="nav-button-img">
  </button>
  <button class="nav-button next-button" id="nextPageBtn">
    <img src="/images/next-button.png" alt="Далее" class="nav-button-img">
  </button>

  <!-- Скрытая информация о странице -->
  <div class="page-info">Страница {{currentPage}} из {{totalPages}}</div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // ----- Данные из шаблона -----
      const personId = '{{personId}}';
      let currentPage = parseInt('{{currentPage}}', 10) || 1;
      let totalPages = parseInt('{{totalPages}}', 10) || 1;

      // Получаем все карточки
      const allCards = document.querySelectorAll('.artifact-card');
      const totalArtifacts = allCards.length;
      
      // Если totalPages неправильное, пересчитываем
      if (totalArtifacts > 0) {
        totalPages = Math.ceil(totalArtifacts / 2);
      }

      // Функция показа карточек для текущей страницы
      function showPage(page) {
        const start = (page - 1) * 2;
        const end = start + 2;
        
        allCards.forEach((card, index) => {
          if (index >= start && index < end) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      }

      // Показываем текущую страницу
      showPage(currentPage);

      // ----- Клик по карточке артефакта -----
      allCards.forEach((card) => {
        card.addEventListener('click', function() {
          const artifactIndex = this.dataset.artifactIndex;
          window.location.href = `/hall/artifact-video/${personId}/${artifactIndex}`;
        });
      });

      // ----- Кнопки пагинации -----
      const prevBtn = document.getElementById('prevPageBtn');
      const nextBtn = document.getElementById('nextPageBtn');

      // Функция обновления состояния кнопок
      function updatePaginationButtons() {
        if (currentPage <= 1) {
          prevBtn.classList.add('disabled');
        } else {
          prevBtn.classList.remove('disabled');
        }

        if (currentPage >= totalPages) {
          nextBtn.classList.add('disabled');
        } else {
          nextBtn.classList.remove('disabled');
        }
      }

      // Обработчики кликов
      prevBtn.addEventListener('click', function(e) {
        if (this.classList.contains('disabled')) return;
        currentPage--;
        showPage(currentPage);
        updatePaginationButtons();
        // Обновляем URL без перезагрузки
        window.history.pushState({}, '', `/hall/artifacts/${personId}?page=${currentPage}`);
      });

      nextBtn.addEventListener('click', function(e) {
        if (this.classList.contains('disabled')) return;
        currentPage++;
        showPage(currentPage);
        updatePaginationButtons();
        window.history.pushState({}, '', `/hall/artifacts/${personId}?page=${currentPage}`);
      });

      // Применяем состояние кнопок
      updatePaginationButtons();
    });
  </script>
</body>
</html>