<div class="autograf-page">
    <!-- Фоновое изображение страницы -->
    <div class="autograf-background"></div>

    <!-- Логотип зала в левом верхнем углу -->
    <img class="hall-logo" src="/images/autograf-hall/hall-logo.png" alt="Зал автографов">
    
    <!-- Плашка в левом верхнем углу (как в других залах) -->
    <div class="top-left-plate">
        <div class="plate-wrapper">
            <div class="plate-bg" style="background-image: url('/images/autograf-hall/autograf-plate.png');"></div>
        </div>
    </div>
    
    <!-- Контент страницы -->
    <div class="autograf-content">
        <!-- Первый текст - цитата (центрирован по центру страницы) -->
        <div class="quote-container">
            <p class="quote">
                Книга с автографом – это не просто текст, написанный на её страницах, 
                это символ глубокой признательности и благодарности, вошедший в историю
            </p>
        </div>

        <!-- Алфавитный указатель (два ряда по 12 изображений) -->
        <div class="alphabet-container">
            {{#each alphabet}}
            <div class="alphabet-letter">
                <img src="{{imagePath}}" alt="Буква {{letter}}" class="letter-image">
            </div>
            {{/each}}
        </div>

        <!-- Второй текст - сообщение о разработке (центрирован по центру страницы) -->
        <div class="development-container">
            <p class="apology">Приносим свои извинения.</p>
            <p class="status">Страница находится в стадии разработки.</p>
            <p class="info">
                Данную информацию можете посмотреть 
                в необновленной версии по ссылке – 
                <a href="https://bibliogorod32.ru/index.php/component/k2/item/1562.html" target="_blank" class="old-site-link">
                    https://bibliogorod32.ru/index.php/component/k2/item/1562.html
                </a>
            </p>
        </div>
    </div>
    
    <!-- Кнопка "Назад" в левом нижнем углу -->
    <a href="/" class="back-button-autograf">
        <img src="/images/back-button.png" alt="Назад" class="back-button-img">
    </a>

    <!-- Кнопка "Далее" в правом нижнем углу (неактивная) -->
    <button class="next-button-autograf disabled" disabled>
        <img src="/images/next-button.png" alt="Далее" class="next-button-img">
    </button>
</div>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }
    
    .autograf-page {
