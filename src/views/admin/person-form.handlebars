<div class="card">
    <div class="card-header">
        {{#if isEdit}}
            Редактирование персоналии: {{person.fullName}}
        {{else}}
            Добавление новой персоналии
        {{/if}}
    </div>

    <form action="{{#if isEdit}}/admin/person/edit/{{person._id}}{{else}}/admin/person/add{{/if}}" method="POST">
        <div class="form-row">
            <div class="form-group">
                <label for="fullName">Полное ФИО *</label>
                <input type="text" id="fullName" name="fullName" value="{{person.fullName}}" required>
            </div>
            <div class="form-group">
                <label for="order">Порядок отображения</label>
                <input type="number" id="order" name="order" value="{{person.order}}" min="0">
                <small style="color: #999;">Чем меньше число, тем выше в списке</small>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="lastName">Фамилия *</label>
                <input type="text" id="lastName" name="lastName" value="{{person.lastName}}" required>
            </div>
            <div class="form-group">
                <label for="firstName">Имя *</label>
                <input type="text" id="firstName" name="firstName" value="{{person.firstName}}" required>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="patronymic">Отчество</label>
                <input type="text" id="patronymic" name="patronymic" value="{{person.patronymic}}">
            </div>
            <div class="form-group">
                <label for="birthYear">Год рождения *</label>
                <input type="number" id="birthYear" name="birthYear" value="{{person.birthYear}}" required>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="deathYear">Год смерти</label>
                <input type="number" id="deathYear" name="deathYear" value="{{person.deathYear}}">
            </div>
            <div class="form-group">
                <label for="isActive">Активен</label>
                <input type="checkbox" id="isActive" name="isActive" {{#if person.isActive}}checked{{/if}}>
                <small style="color: #999; margin-left: 10px;">Отображать на сайте</small>
            </div>
        </div>

        <div class="form-group">
            <label for="photoPath">Путь к фото (относительный)</label>
            <input type="text" id="photoPath" name="photoPath" value="{{person.photoPath}}" placeholder="/images/persons/имя_файла.jpg">
            <small style="color: #999;">Путь к изображению персоналии (например: /images/persons/ivanov.jpg)</small>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="buttonImagePath">Путь к кнопке (относительный)</label>
                <input type="text" id="buttonImagePath" name="buttonImagePath" value="{{person.buttonImagePath}}" placeholder="/images/literary-hall/button.png">
                <small style="color: #999;">Изображение для кнопки на главной странице зала</small>
            </div>
            <div class="form-group">
                <label for="titleImagePath">Путь к плашке (относительный)</label>
                <input type="text" id="titleImagePath" name="titleImagePath" value="{{person.titleImagePath}}" placeholder="/images/literary-hall/title.png">
                <small style="color: #999;">Изображение для плашки на странице персоналии</small>
            </div>
        </div>

        <div class="form-group">
            <label for="shortBio">Краткая биография (для страницы персоналии) *</label>
            <textarea id="shortBio" name="shortBio" rows="3" required>{{person.shortBio}}</textarea>
        </div>

        <div class="form-group">
            <label for="biography">Полная биография *</label>
            <textarea id="biography" name="biography" rows="6" required>{{person.biography}}</textarea>
        </div>

        {{#if isEdit}}
            <div class="card" style="margin-top: 30px;">
                <div class="card-header">
                    Артефакты ({{person.artifacts.length}})
                    <a href="/admin/person/{{person._id}}/artifact/add" class="btn btn-success btn-sm" style="float: right;">+ Добавить артефакт</a>
                </div>
                
                {{#if person.artifacts.length}}
                    <div class="artifact-list">
                        {{#each person.artifacts}}
                            <div class="artifact-item">
                                <div class="artifact-info">
                                    <div class="artifact-name">{{name}}</div>
                                    <div class="artifact-desc">{{description}}</div>
                                    <div style="font-size: 12px; color: #999; margin-top: 3px;">
                                        {{#if year}}Год: {{year}}{{/if}}
                                        {{#if material}} • Материал: {{material}}{{/if}}
                                        {{#if dimensions}} • Размер: {{dimensions}}{{/if}}
                                    </div>
                                </div>
                                <div class="artifact-actions">
                                    <a href="/admin/person/{{../person._id}}/artifact/edit/{{@index}}" class="btn btn-primary btn-xs">Ред.</a>
                                    <form action="/admin/person/{{../person._id}}/artifact/delete/{{@index}}" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-danger btn-xs delete-artifact-confirm">Удалить</button>
                                    </form>
                                </div>
                            </div>
                        {{/each}}
                    </div>
                {{else}}
                    <p style="color: #999; padding: 20px; text-align: center;">У этой персоналии пока нет артефактов</p>
                {{/if}}
            </div>
        {{/if}}

        <div style="margin-top: 30px; display: flex; gap: 15px;">
            <button type="submit" class="btn btn-success">
                {{#if isEdit}}Сохранить изменения{{else}}Добавить персоналию{{/if}}
            </button>
            <a href="/admin" class="btn btn-warning">Отмена</a>
        </div>
    </form>
</div>