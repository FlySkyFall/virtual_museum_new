<div class="admin-header-bar">
    <h2>Управление персоналиями</h2>
    <p>Зал литературного краеведения</p>
</div>

<div style="margin-bottom: 20px;">
    <a href="/admin/person/add" class="btn btn-success">+ Добавить новую персоналию</a>
</div>

{{#if persons.length}}
    <div class="persons-grid">
        {{#each persons}}
            <div class="person-card">
                <img src="{{photoPath}}" alt="{{fullName}}" class="card-image" onerror="this.src='/images/persons/placeholder.jpg'">
                <div class="card-body">
                    <div class="card-title">{{fullName}}</div>
                    <div class="card-subtitle">
                        {{birthYear}}{{#if deathYear}} - {{deathYear}}{{/if}}
                        <span class="badge {{#if isActive}}badge-success{{else}}badge-danger{{/if}}" style="margin-left: 10px;">
                            {{#if isActive}}Активен{{else}}Неактивен{{/if}}
                        </span>
                    </div>
                    <div class="card-text">
                        <strong>Артефактов:</strong> {{artifacts.length}}<br>
                        <strong>Порядок:</strong> {{order}}
                    </div>
                    <div class="card-actions">
                        <a href="/admin/person/edit/{{_id}}" class="btn btn-primary btn-sm">Редактировать</a>
                        <form action="/admin/person/delete/{{_id}}" method="POST" style="display: inline;">
                            <button type="submit" class="btn btn-danger btn-sm delete-confirm">Удалить</button>
                        </form>
                    </div>
                </div>
            </div>
        {{/each}}
    </div>
{{else}}
    <div class="card" style="text-align: center; padding: 60px 20px;">
        <h3 style="color: #999;">Пока нет ни одной персоналии</h3>
        <p style="color: #999; margin-top: 10px;">Нажмите кнопку выше, чтобы добавить первую</p>
    </div>
{{/if}}